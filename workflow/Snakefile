    partdist=PARTITION_MAX_DISTANCE, maxedit=MAX_EDIT_DISTANCE,
    maxsv=MAX_SV_SIZE, qgap=QUERY_GAP_TOLERANCE, rgap=REFERENCE_GAP_TOLERANCE))

final_inputs.extend(expand(
    EQTL_BASE + f"/chr{{chr}}/{COV_STRING}{EQTL_PEER}/window_{{window}}/cis_qtl_results.tsv",
    chr=SV_CHRS, window=CIS_WINDOWS,
