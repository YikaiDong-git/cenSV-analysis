    maxsv=MAX_SV_SIZE, qgap=QUERY_GAP_TOLERANCE, rgap=REFERENCE_GAP_TOLERANCE))

final_inputs.extend(expand(
    STRAT_IMP_BASE + "/best8_" + STRAT_SVIM_SUFFIX + "/chr{chr}/chr{chr}_imputed_dosages.tsv",
    chr=SV_CHRS,
